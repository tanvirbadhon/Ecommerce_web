# Public Firebase Web API key from Project settings > Your apps > Web app.
STORE_WEB_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
# Leave empty until an additional domain is connected. Separate HTTPS origins with commas.
STORE_EXTRA_ORIGINS=
# Use the exact bucket name from Firebase Storage (do not guess its suffix).
STORE_PRODUCT_BUCKET=REPLACE_WITH_STORAGE_BUCKET_NAME
